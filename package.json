{
	"name": "obsidian-surface",
	"version": "1.3.0",
	"description": "Surface Readwise highlights semantically related to your current note.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"prebuild": "node scripts/sync-version.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node scripts/prepare-release.mjs && git add manifest.json CHANGELOG.md",
		"version:patch": "npm version patch --tag-version-prefix=''",
		"version:minor": "npm version minor --tag-version-prefix=''",
		"version:major": "npm version major --tag-version-prefix=''"
	},
	"keywords": [],
	"author": "Coleman",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^16.11.6",
		"builtin-modules": "^3.3.0",
		"esbuild": "0.17.3",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"typescript": "4.7.4"
	}
}
