{
	"name": "obsidian-recall",
	"version": "1.2.1",
	"description": "Surface Readwise highlights semantically related to your current note.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"prebuild": "node scripts/sync-version.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node scripts/sync-version.mjs && git add manifest.json",
		"version:patch": "npm version patch",
		"version:minor": "npm version minor",
		"version:major": "npm version major"
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^16.11.6",
		"builtin-modules": "^3.3.0",
		"esbuild": "0.17.3",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"typescript": "4.7.4"
	}
}
